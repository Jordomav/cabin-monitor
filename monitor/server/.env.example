# Copy to .env and fill in. .env is gitignored.

# Auth for CC:Tweaked -> /update and /commands
API_KEY=your-minecraft-api-key-here

# Dashboard login
DASHBOARD_PASSWORD=your-dashboard-password-here
SESSION_SECRET=your-long-random-session-secret-here

# HTTP + WebSocket share this single port (WS served on the same port).
PORT=3000

# --- Milestone 5 (push notifications) — not used by the skeleton yet ---
# Generate once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_EMAIL=your@email.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
